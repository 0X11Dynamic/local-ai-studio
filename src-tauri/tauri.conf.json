{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Studio",
  "version": "0.1.0",
  "identifier": "com.localaistudio.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local AI Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#0f1012"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://huggingface.co https://*.hf.co; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}